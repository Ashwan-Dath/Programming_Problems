// Minimum Sum Subarray


// Given an array arr[], find the sub-array containing at least one number which has the minimum sum and return its sum.

// Examples :
// Input: arr[] = [3,-4, 2,-3,-1, 7,-5]
// Output: -6
// Explanation: The subarray is [-4,2,-3,-1] = -6

// Input: arr[] = [2, 6, 8, 1, 4]
// Output: 1
// Explanation: The subarray is [1] = 1
// Constraints:

// 1 ≤ arr.size() ≤ 106
// -107 ≤ arr[i] ≤ 107

public class Main{
    public static int maxSubArray(int[] nums) {
        int best = nums[0];
        int res = nums[0];

        for(int i = 1; i < nums.length; i++){
            int now = nums[i];
            int prev = best + nums[i];
            best = Math.min(prev, now);
            res = Math.min(best, res);
        }
        return res;
        
    }

    public static void main(String []args){
        // Input: nums = [-2,1,-3,4,-1,2,1,-5,4] Output: 6
        // Input: nums = [5,4,-1,7,8] Output: 23
        int input[] = {2, 6, 8, 1, 4};
        int val = maxSubArray(input);
        System.out.println("Val " + val);
    }
}
