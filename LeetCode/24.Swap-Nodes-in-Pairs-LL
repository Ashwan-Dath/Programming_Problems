		ListNode temp = head;
		while(temp != null) {
			System.out.println("temp : " + temp + " temp.val : " + temp.val);
// 			System.out.println("temp.val : " + temp.val);
			temp = temp.next;
		}
		System.out.println();
	}


	public static void main(String[] args) {

		Main x = new Main();
		
        // Input: head = [1,2,3,4,5], k = 2 Output: [1,4,3,2,5]
        // Input: head = [7,9,6,6,7,8,3,0,9,5], k = 5   Output: [7,9,6,6,8,7,3,0,9,5]

		int arr[] = {7,9,6,6,7,8,3,0,9,5};
