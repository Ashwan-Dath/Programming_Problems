// 24. Swap Nodes in Pairs

// Given a linked list, swap every two adjacent nodes and return its head. 
// You must solve the problem without modifying the values in the list's nodes 
// (i.e., only nodes themselves may be changed.)

 

// Example 1:
// Input: head = [1,2,3,4]
// Output: [2,1,4,3]
// Explanation:
// [1,2,3,4] -> [2,1,4,3] = Here we are swapping the 1, 2 and 3, 4 nodes..



// Example 2:
// Input: head = []
// Output: []

// Example 3:
// Input: head = [1]
// Output: [1]

// Example 4:
// Input: head = [1,2,3]
// Output: [2,1,3]
// [1,2,3] -> [2,1,3] == Here we have swapped 1, 2 nodes and left the 3rd node because it doesn't have pair.
 

// Constraints:

// The number of nodes in the list is in the range [0, 100].
// 0 <= Node.val <= 100



class ListNode {
	int val;
	ListNode next;
	ListNode(int x) {
		val = x;
		next = null;
	}
}

public class Main
{

	ListNode head;
	ListNode prev;
	int size = 0;

	void insert(int val) {
		ListNode temp;
		if(head == null) {
			head = new ListNode(val);
			prev = head;
			System.out.println("head : " + head);
		} else {
			temp = new ListNode(val);
			prev.next = temp;
			prev = temp;
			System.out.println("temp : " + temp);
		}
		size++;

	}

	void circular(int pos) {
		if(pos == -1)
			return;

		int count = 0;
		ListNode temp = head;
		while(temp != null) {
			if(count == pos) {
				prev.next = temp;
				System.out.println("temp " + temp);
				break;
			}
			temp = temp.next;
			count++;
			System.out.println("count " + count + " pos " + pos);
		}
	}
	
    public ListNode swapPairs(ListNode head) {
        
        // Approach: Iterative / Pointer Manipulation

        // 1. We use a temp pointer to traverse the linked list pair by pair.
        // 2. For every pair, we store the first node in `first` and the same node
        //    in `dup` so that we can identify whether we are processing the first pair.
        // 3. We move `temp` to the second node and store it in `second`.
        // 4. We swap the positions of the two nodes by changing their `next` pointers:
        //      - second.next = first.next
        //      - first.next = second
        // 5. We move `temp` to the beginning of the next pair using:
        //      temp = second.next
        // 6. If this is the first pair, we update `head` to `first` because `first`
        //    is now the new head of the list.
        // 7. Otherwise, we connect the previous swapped pair to the current pair:
        //      prev.next = first
        // 8. We update `prev = second` because `second` is now the last node
        //    of the current swapped pair.
        // 9. We repeat this until there are fewer than two nodes left.
        
        // Time Complexity: O(n)
        //   - Each node is visited a constant number of times.
        //   - Therefore, the total time is O(n).
        
        // Space Complexity: O(1)
        //   - We only use pointers such as temp, prev, first, second and dup.
        //   - No extra data structure is used.

        
        System.out.println("-");
        ListNode temp = head;
        ListNode prev = head;
        
        while(temp != null && temp.next != null){
            ListNode first = temp;
            ListNode dup = temp;
            temp = temp.next;
            ListNode second = temp;
            
            System.out.println("first " + first +" val " + first.val);
            System.out.println("second " + second +" val " + second.val);
            System.out.println("dup " + dup + " val " + dup.val);
            
            first = second;
            second = dup;
            
            System.out.println("after first " + first +" val " + first.val );
            System.out.println("after second " + second +" val " + second.val);
            System.out.println("after dup " + dup +" val " + dup.val);
            
            System.out.println("second.next " + second.next);
            System.out.println("second " + second);
            System.out.println("first.next " + first.next);
            second.next = first.next;
            first.next = second;
            temp = second.next;
            System.out.println("after second.next " + second.next);
            System.out.println("after first.next " + first.next);
            
            if(dup == head){
                head = first;
            }else{
                prev.next = first;
            }

                prev = second;

            
            System.out.println("temp " + temp);
            System.out.println();
            
            
        }
        System.out.println("- head " + head);
        print();
        return head;
    }
    



	void print() {
