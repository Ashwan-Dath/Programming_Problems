// Find the Middle Node of a Singly Linked List with a Cycle



// Given the head of a singly linked list that contains a cycle,
// return the middle node of the linked list.

// The starting position of the cycle is not given as a parameter.
// You must determine the cycle and find the middle node using only
// the head of the linked list.

// If the linked list has an odd number of nodes, return the exact
// middle node.

// If the linked list has an even number of nodes, return the second
// middle node.

// Example 1:
// Input: head = [1,2,3,4,5], pos = 2
// Output: [3,4,5]
// Explanation: The list contains a cycle where node 5 points to node 3.
// The total number of nodes is 5, so the middle node is node 3.

// Example 2:
// Input: head = [1,2,3,4,5,6], pos = 1
// Output: [4,5,6,2,3]
// Explanation: The list contains a cycle where node 6 points to node 2.
// The total number of nodes is 6, so the two middle nodes are 3 and 4.
// We return the second middle node, which is node 4.

// Example 3:
// Input: head = [1,2,3,4], pos = 0
// Output: [3,4]
// Explanation: The list contains a cycle where node 4 points to node 1.
// The total number of nodes is 4, so the two middle nodes are 2 and 3.
// We return the second middle node, which is node 3.

// Constraints:
// The number of unique nodes in the list is in the range [1, 100].
// 1 <= Node.val <= 100
// The linked list contains a cycle.
// The cycle can start at any node.
// The cycle starting position (pos) is not given to the method.
// Only head is provided as input.

 
class ListNode{
    int val;
    ListNode next;
    ListNode(int x){
        val = x;
        next = null;
    }
}

public class Main
{
    
    ListNode head;
    ListNode prev;
    int size = 0;
    
    void insert(int val){
        ListNode temp;
        if(head == null){
            head = new ListNode(val);
            prev = head;
            System.out.println("head : " + head);
        }else{
            temp = new ListNode(val);
            prev.next = temp;
            prev = temp;
            System.out.println("temp : " + temp);
        }
        size++;
        
    }
    
    void circular(int pos){
        if(pos == -1)
            return;
            
        int count = 0;
        ListNode temp = head;
        while(temp != null){
            if(count == pos){
                prev.next = temp;
                System.out.println("temp " + temp);
                break;
            }
            temp = temp.next;
            count++;
            System.out.println("count " + count + " pos " + pos);
        }
    }
    
    public ListNode midPoint(ListNode head) {
        
        // Approach:
        // 1. Use Floyd's Cycle Detection algorithm (slow and fast pointers)
        //    to detect whether the linked list contains a cycle.
        // 2. Once slow == fast, reset slow to head and move both pointers
        //    one step at a time to find the starting node of the cycle.
        // 3. Traverse the cycle to count the total number of nodes in the list.
        // 4. Calculate the middle position using count / 2.
        // 5. Move to the next node when required to return the start of the
        //    second half of the list.
        //
        // Time Complexity: O(n)
        // Space Complexity: O(1)
        

        ListNode slow = head;
        ListNode fast = head;
        int count = 1;
        ListNode temp;
        aa:
        while(fast != null && fast.next != null){
            slow = slow.next;
            fast = fast.next.next;
            if(slow == fast){
                slow = head;
                while(slow != fast){
                    System.out.print("slow " + slow);
                    System.out.println("  fast " + fast);
                    count++;
                    slow = slow.next;
                    fast = fast.next;
                }
                break aa;
            }
        }
        System.out.println(count);
        temp = slow;
        do{
            slow = slow.next;
            count++;
        }while(slow != temp);
        
        System.out.println(count);
        int mid = count / 2;
        if(count%2 == 1){
            mid += 1;
            slow = slow.next;
        }
            
        System.out.println("mid " + mid);
        return slow;
    }

    
    void print(){
        ListNode temp = head;
        while(temp != null){
            System.out.println("temp.val : " + temp);
            temp = temp.next;
        }
        System.out.println();
    }
    
    
	public static void main(String[] args) {
	    Main x = new Main();
	    
	    int arr[] = {1,2,3,4,5};
	    int pos = 2;
        for(int i = 0; i < arr.length; i++){
            x.insert(arr[i]);
        }
	    x.print();
	    x.circular(pos);
	   ListNode b = x.midPoint(x.head);
	   System.out.println(b);
	   
	}
}
