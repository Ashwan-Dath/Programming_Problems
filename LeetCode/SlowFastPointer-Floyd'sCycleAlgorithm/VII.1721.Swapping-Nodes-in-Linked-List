// 1721. Swapping Nodes in a Linked List

// You are given the head of a linked list, and an integer k.

// Return the head of the linked list after swapping the values of the kth node 
// from the beginning and the kth node from the end (the list is 1-indexed).

 

// Example 1:
// Input: head = [1,2,3,4,5], k = 2
// Output: [1,4,3,2,5]

// Example 2:
// Input: head = [7,9,6,6,7,8,3,0,9,5], k = 5
// Output: [7,9,6,6,8,7,3,0,9,5]
 

// Constraints:
// The number of nodes in the list is n.
// 1 <= k <= n <= 105
// 0 <= Node.val <= 100



class ListNode {
	int val;
	ListNode next;
	ListNode(int x) {
		val = x;
		next = null;
	}
}

public class Main
{

	ListNode head;
	ListNode prev;
	int size = 0;

	void insert(int val) {
		ListNode temp;
		if(head == null) {
			head = new ListNode(val);
			prev = head;
			System.out.println("head : " + head);
		} else {
			temp = new ListNode(val);
			prev.next = temp;
			prev = temp;
			System.out.println("temp : " + temp);
		}
		size++;

	}

	void circular(int pos) {
		if(pos == -1)
			return;

		int count = 0;
		ListNode temp = head;
		while(temp != null) {
			if(count == pos) {
				prev.next = temp;
				System.out.println("temp " + temp);
				break;
			}
			temp = temp.next;
			count++;
			System.out.println("count " + count + " pos " + pos);
		}
	}

    public ListNode swapNodes(ListNode head, int k) {
        
        // Approach: Two Pointer
        // 1. First, we traverse to the kth node from the beginning using the temp pointer.
        // 2. We set fast = temp and slow = head.
        // 3. Since fast is already at the kth node, there is a gap of k - 1 nodes
        //    between slow and fast.
        // 4. We move both fast and slow together until fast reaches the last node.
        // 5. When fast reaches the last node, slow will be pointing to the kth node
        //    from the end.
        // 6. Now, temp represents the kth node from the beginning and
        //    slow represents the kth node from the end.
        // 7. Finally, we swap their values and return the head.
        //
        // Time Complexity: O(n)
        //   - Finding the kth node takes O(k).
        //   - Moving fast and slow takes O(n - k).
        //   - Total = O(k) + O(n - k) = O(n).
        //
        // Space Complexity: O(1)
        //   - We only use a few pointers and one temporary variable.
        //   - No extra data structure is used.
        
        if(head.next == null)
            return head;
        
        ListNode temp = head;
        
        for(int i = 1; i < k; i++){
            temp = temp.next;
        }
        
        ListNode fast = temp;
        ListNode slow = head;
        
        while(fast.next != null){
            fast = fast.next;
            slow = slow.next;
        }
        
        if(k != 0){
            int tempVal = temp.val;
            temp.val = slow.val;
            slow.val = tempVal;
        }
        
        return head;
        
    }


	void print() {
		System.out.println("Print");
		ListNode temp = head;
		while(temp != null) {
			System.out.println("temp : " + temp);
			System.out.println("temp.val : " + temp.val);
			temp = temp.next;
		}
		System.out.println();
	}


	public static void main(String[] args) {

		Main x = new Main();
		
        // Input: head = [1,2,3,4,5], k = 2 Output: [1,4,3,2,5]
        // Input: head = [7,9,6,6,7,8,3,0,9,5], k = 5   Output: [7,9,6,6,8,7,3,0,9,5]

		int arr[] = {7,9,6,6,7,8,3,0,9,5};
		int pos = 0;
		for(int i = 0; i < arr.length; i++) {
			x.insert(arr[i]);
		}
		x.print();
		// x.circular(pos);
		//x.head = x.midPoint(x.head);
		x.head = x.swapNodes(x.head, pos);
		x.print();
		//System.out.println(b);

	}
}
