// 876. Middle of the Linked List

// Given the head of a singly linked list, return the middle node of the linked list.

// If there are two middle nodes, return the second middle node.

 

// Example 1:
// Input: head = [1,2,3,4,5]
// Output: [3,4,5]
// Explanation: The middle node of the list is node 3.

// Example 2:
// Input: head = [1,2,3,4,5,6]
// Output: [4,5,6]
// Explanation: Since the list has two middle nodes with values 3 and 4, we return the second one.
 

// Constraints:
// The number of nodes in the list is in the range [1, 100].
// 1 <= Node.val <= 100



 
class ListNode{
    int val;
    ListNode next;
    ListNode(int x){
        val = x;
        next = null;
    }
}

public class Main
{
    
    ListNode head;
    ListNode prev;
    int size = 0;
    
    void insert(int val){
        ListNode temp;
        if(head == null){
            head = new ListNode(val);
            prev = head;
            System.out.println("head : " + head);
        }else{
            temp = new ListNode(val);
            prev.next = temp;
            prev = temp;
            System.out.println("temp : " + temp);
        }
        size++;
        
    }
    
    void circular(int pos){
        if(pos == -1)
            return;
            
        int count = 0;
        ListNode temp = head;
        while(temp != null){
            if(count == pos){
                prev.next = temp;
                System.out.println("temp " + temp);
                break;
            }
            temp = temp.next;
            count++;
            System.out.println("count " + count + " pos " + pos);
        }
    }
    
    public ListNode hasCycle(ListNode head) {
        
        // Approach:
        // We use Floyd's Cycle Detection Algorithm, also known as the
        // Slow and Fast Pointer technique.
        
        // - Initialize two pointers, slow and fast, at the head of the list.
        // - Move slow one node at a time.
        // - Move fast two nodes at a time.
        // - If there is no cycle:
        //     - fast will eventually reach null.
        //     - Therefore, return false.
        // - If there is a cycle:
        //     - slow and fast will eventually meet at the same node.
        //     - Therefore, return true.
        // - Continue this process until either:
        //     - fast becomes null or fast.next becomes null, meaning there is no cycle.
        //     - slow == fast, meaning a cycle exists.
        
        // Time Complexity:
        // O(n)
        // In the worst case, the pointers may traverse the linked list multiple times,
        // but the total number of steps is linear with respect to the number of nodes.
        
        // Space Complexity:
        // O(1)
        // Only two pointers (slow and fast) are used.
        // No extra data structures are required.
        
        ListNode slow = head;
        ListNode fast = head;
        int count = 1;
        ListNode temp;
        aa:
        while(fast != null && fast.next != null){
            slow = slow.next;
            fast = fast.next.next;
            if(slow == fast){
                slow = head;
                while(slow != fast){
                    System.out.print("slow " + slow);
                    System.out.println("  fast " + fast);
                    count++;
                    slow = slow.next;
                    fast = fast.next;
                }
                break aa;
            }
        }
        System.out.println(count);
        temp = slow;
        slow = slow.next;
        do{
            slow = slow.next;
            count++;
        }while(slow != temp);
        System.out.println(count);
        int mid = count / 2;
        System.out.println("mid " + mid);
        
        return slow;
    }

    
    void print(){
        ListNode temp = head;
        while(temp != null){
            System.out.println("temp.val : " + temp);
            temp = temp.next;
        }
        System.out.println();
    }
    
    
	public static void main(String[] args) {
	    Main x = new Main();
	    
	    // Input: head = [3,2,0,-4], pos = 1 output = true
	    // Input: head = [1,2], pos = 0  Output: true
        // Input: head = [1], pos = -1  Output: false

// Input: head = [1,2,3,4,5,6]

	    int arr[] = {1,2,3,4,5};
	    int pos = 2;
        for(int i = 0; i < arr.length; i++){
            x.insert(arr[i]);
        }
	    x.print();
	    x.circular(pos);
	   // x.print();
	   ListNode b = x.hasCycle(x.head);
	   System.out.println(b);
	   
	}
}
