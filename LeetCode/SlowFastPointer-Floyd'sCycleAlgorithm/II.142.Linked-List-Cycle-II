	    Main x = new Main();
	    
	    
	    // Input: head = [3,2,0,-4], pos = 1 output = true
	    // Input: head = [1,2], pos = 0  Output: true
        // Input: head = [1], pos = -1  Output: false
        
        
// Input head = [1,2] pos =  0
// Output  tail connects to node index 1
// Expected  tail connects to node index 0

