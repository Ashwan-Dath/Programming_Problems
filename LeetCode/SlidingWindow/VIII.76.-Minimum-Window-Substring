// 76. Minimum Window Substring
// Given two strings s and t of lengths m and n respectively, return the minimum window substring of s such that 
// every character in t (including duplicates) is included in the window. If there is no such substring, return the empty string "".

// The testcases will be generated such that the answer is unique.

 
// Example 1:
// Input: s = "ADOBECODEBANC", t = "ABC"
// Output: "BANC"
// Explanation: The minimum window substring "BANC" includes 'A', 'B', and 'C' from string t.

// Example 2:
// Input: s = "a", t = "a"
// Output: "a"
// Explanation: The entire string s is the minimum window.

// Example 3:
// Input: s = "a", t = "aa"
// Output: ""
// Explanation: Both 'a's from t must be included in the window.
// Since the largest window of s only has one 'a', return empty string.
 

// Constraints:

// m == s.length
// n == t.length
// 1 <= m, n <= 105
// s and t consist of uppercase and lowercase English letters.
 

// Follow up: Could you find an algorithm that runs in O(m + n) time?


import java.util.HashMap;

public class Main{
    
    static boolean allCheck(HashMap<Character, Integer> original, HashMap<Character, Integer> compare){
        System.out.println();
        for(Character val: original.keySet()){
            System.out.print(" val " + val);
            System.out.print(" original.get(val) " + original.get(val));
            // System.out.print(" compare.get(val) " + compare.get(.val));
            System.out.print(" compare.getOrDefault(val, 0) " + compare.getOrDefault(val, 0));
            if(compare.getOrDefault(val, 0) < original.get(val)){
                System.out.println();
                return false;
            }
            
        }
        return true;
    }
    
    public static void main(String[] args){
        
// Input: s = "ADOBECODEBANC", t = "ABC"
// Output: "BANC"

        String s = "ADOBECODEBANC";
        String t = "ABC";
        int start = 0;
        int end = 0;
        int MinLen = Integer.MAX_VALUE;
        int low = 0;
        int high = 0;
        HashMap<Character, Integer> original = new HashMap<>();
        HashMap<Character, Integer> compare = new HashMap<>();
        
        for(int i = 0; i < t.length(); i++){
            original.put(t.charAt(i) ,(original.getOrDefault(t.charAt(i), 0) +1));
        }
        
        System.out.println(original);
        
        while(high < s.length()){
            
            char hchar = s.charAt(high);
            
            if(original.containsKey(hchar)){
                compare.put(hchar ,(compare.getOrDefault(hchar, 0) +1));
                // compare.put(hchar, checker.get(hchar) + 1);
            }
            
            boolean b = allCheck(original, compare);
            System.out.println("B " + b);
            while(b){
                int length = high - low + 1;
                
                if(MinLen > length){
                    MinLen = length;
                    start = low;
                    end = high;
                    System.out.print(" start " + start + " end " + end);
                }
                // MinLen = Math.min(MinLen, length);
                // if(MinLen  <)
                
                char lchar = s.charAt(low);
                if(original.containsKey(lchar)){
                    compare.put(lchar ,(compare.get(lchar) -1));
                }
                b = allCheck(original, compare);
                low++;
            }

            System.out.print(" low " + low + " high " + high);
            System.out.println("Checker Boolean : " + b + " char : "+ hchar + " MinLen "+ MinLen);
            high++;
        }
        
        while(start <= end){
            System.out.print(s.charAt(start++));
            // ++;
        }
    }
}

