public class Main {

	static int subArraySum(int []arr, int target) {
	    
        // Variable Size Sliding Window
        //
        // low  -> points to the start of the current window
        // high -> points to the end of the current window
        //
        // We maintain the sum of the current window.
        //
        // Initially, both low and high are 0 and sum is 0.
        //
        // Expand the window by adding nums[high] to sum.
        // We continue expanding until sum becomes greater than
        // or equal to target.
        //
        // Once sum >= target, the current window is a valid window.
        // We calculate its length and update minLen.
        //
        // Then we shrink the window from the left by removing
        // nums[low] and incrementing low.
        //
        // We keep shrinking while sum >= target because there
        // may be a smaller valid window.
        //
        // When sum becomes less than target, we stop shrinking
        // and expand the window again by moving high forward.
        //
        // Since all numbers in nums are positive, increasing the
        // window always increases the sum and decreasing the
        // window always decreases the sum.
        //
        // If no valid window is found, minLen remains
        // Integer.MAX_VALUE, so we return 0.
        //
        // Time Complexity: O(n)
        //
        // Although there is a for loop and a while loop,
        // it is still O(n) because low and high only move
        // forward and each element is added and removed at most once.
        //
        // Space Complexity: O(1)
        //
        // We only use a few variables (low, high, minLen, sum)
        // and do not use any additional data structure.
        // ---------------------------------------------------------

        int low = 0;
        int high = 0;
        int minLen = Integer.MAX_VALUE;

        int sum = 0;

        for(int i = high; i < nums.length; i++){

            sum += nums[high];

            while(sum >= target){
                minLen = Math.min(minLen, (high - low + 1));
                sum -= nums[low];
                low++;

            }
            high++;
        }
        return minLen == Integer.MAX_VALUE ? 0 : minLen;

	    




















