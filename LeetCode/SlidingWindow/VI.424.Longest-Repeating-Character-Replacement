// 424. Longest Repeating Character Replacement

// You are given a string s and an integer k. You can choose any character of the string and 
// change it to any other uppercase English character. You can perform this operation at most k times.

// Return the length of the longest substring containing the same letter you can get 
// after performing the above operations.

 

// Example 1:
// Input: s = "ABAB", k = 2
// Output: 4
// Explanation: Replace the two 'A's with two 'B's or vice versa.

// Example 2:
// Input: s = "AABABBA", k = 1
// Output: 4
// Explanation: Replace the one 'A' in the middle with 'B' and form "AABBBBA".
// The substring "BBBB" has the longest repeating letters, which is 4.
// There may exists other ways to achieve this answer too.
 

// Constraints:
// 1 <= s.length <= 105
// s consists of only uppercase English letters.
// 0 <= k <= s.length


import java.util.Scanner;
import java.util.Arrays;

public class Main
{
    static int maxChar(int []arr){
        int max = Integer.MIN_VALUE;
        for(int i = 0; i < arr.length; i++){
            max = Math.max(max, arr[i]);
        }
        return max;
    }
    
    
    public static int characterReplacement(String s, int k) {
    
        int arr[] = new int[255];
	    int low = 0;
	    int high = 0;
	    int maxLen = Integer.MIN_VALUE;
	    
	    while(high < s.length()){

	        char c = s.charAt(high);
	        arr[c-65] = ++arr[c-65];
	        int length = high - low + 1;
	        int hiFre = maxChar(arr);
	        int diff = length - hiFre;

	        while(diff > k){
	            arr[s.charAt(low) - 65] = --arr[s.charAt(low) - 65];
	            low++;
	            length = high - low + 1;
	            hiFre = maxChar(arr);
	            diff = length - hiFre;
	        }
	        
	        length = high - low + 1;
	        maxLen = Math.max(maxLen, length);
	        high++;

	    }
        return maxLen;
    }


    
	public static void main(String[] args) {
	    
	    Scanner sc = new Scanner(System.in);
	    
	    String s = sc.next();
	    int k = sc.nextInt();
	    
	    if(s.length > 105 || s.length < 1 ){
            System.out.println("The String length should be in between 1 to 105.");
	        return;
	    }
	    
	    for(int i = 0; i < s.length(); i++){
	        if(s.charAt(i) < 65 && s.charAt(i) > 90){
	            System.out.println("The String should contain only the Capital Letters.");
	            return;
	        }
	    }
	    
	    if(k < 0 || k > s.length()){
            System.out.println("The k should be in between the 0 and " + s.length()+ ".");
	    }
	    
	    int value = characterReplacement(s, k);
	    System.out.println("The value = " + value);
	    
	    // 1 <= s.length <= 105
        // s consists of only uppercase English letters.
        // 0 <= k <= s.length

	}
}




