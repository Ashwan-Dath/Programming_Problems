// Max Sum Subarray of size K

// Given an array of integers arr[]  and a number k. Return the maximum sum of a subarray of size k.

// Note: A subarray is a contiguous part of any given array.

// Examples:
// Input: arr[] = [100, 200, 300, 400], k = 2
// Output: 700
// Explanation: arr2 + arr3 = 700, which is maximum.

// Input: arr[] = [1, 4, 2, 10, 23, 3, 1, 0, 20], k = 4
// Output: 39
// Explanation: arr1 + arr2 + arr3 + arr4 = 39, which is maximum.

// Input: arr[] = [100, 200, 300, 400], k = 1
// Output: 400
// Explanation: arr3 = 400, which is maximum.

// Constraints:
// 1 ≤ arr.size() ≤ 106
// 0 ≤ arr[i] ≤ 106
// 1 ≤ k ≤ arr.size()

public class Main
{
	public static int maxSubarraySum(int[] arr, int k) {

		// Approach - Sliding Window
		// We take a window of size k and calculate the sum of the first k elements.
		// Then we slide the window one element at a time.
		// For every slide, we remove the element going out of the window
		// and add the new element coming into the window.
		// This avoids recalculating the entire window sum every time.
		// We keep updating sumMax with the maximum window sum found.
		//
		// Time Complexity - O(n)
		// We traverse the array once. Each element is added and removed at most once.
		//
		// Space Complexity - O(1)
		// We only use a few variables and no extra data structure.
		// -------------------------------------------------

		int left = 0;
		int right = k - 1;
		int sumMax = 0;
		int sum = 0;

		for(int i = left; i <= right; i++)
			sum += arr[i];

		while(right < arr.length) {
			sumMax = Math.max(sum, sumMax);

			left++;
			right++;

			if(right == arr.length) {
				break;

			}

			sum = sum - arr[left - 1] + arr[right];
		}

		return sumMax;
	}

	public static void main(String[] args) {
		int arr[] = {100,200, 300, 400};
		int k = 4;
		int val = maxSubarraySum(arr, k);
		System.out.println("Max Sum : " + val);
	}
}
