// 7. Reverse Integer
// Given a signed 32-bit integer x, return x with its digits reversed.
// If reversing x causes the value to go outside the signed 32-bit integer
// range [-2^31, 2^31 - 1], then return 0.

// Assume the environment does not allow you to store 64-bit integers
// (signed or unsigned).

// Example 1:
// Input: x = 123
// Output: 321

// Example 2:
// Input: x = -123
// Output: -321

// Example 3:
// Input: x = 120
// Output: 21

// Constraints:
// -2^31 <= x <= 2^31 - 1

import java.util.Scanner;

public class Main {

    public static int reverse(int x) {

        // Approach:
        // - Extract the last digit of the number using the modulo (%) operator.
        // - Append the extracted digit to the reversed number.
        // - Remove the last digit from the original number.
        // - Repeat until the original number becomes 0.
        // - Before appending the digit, check whether multiplying the current
        //   reversed number by 10 would cause an integer overflow.
        // - If overflow is detected, return 0.

        // Time Complexity: O(d)
        // - 'd' is the number of digits in the integer.
        // - Each iteration processes one digit.
        // - Therefore, the time complexity is O(d).
        // - Since an integer has at most 10 digits, it is effectively O(1).

        // Space Complexity: O(1)
        // - Only a few integer variables are used.
        // - No extra data structures are created.

        int rev = 0;

        // Continue until all digits are processed.
        while (x != 0) {

            // Extract the last digit.
            int digit = x % 10;

            // Check for positive overflow.
            if (rev > Integer.MAX_VALUE / 10 ||
                (rev == Integer.MAX_VALUE / 10 && digit > 7))
                return 0;

            // Check for negative overflow.
            if (rev < Integer.MIN_VALUE / 10 ||
                (rev == Integer.MIN_VALUE / 10 && digit < -8))
                return 0;

            // Append the extracted digit.
            rev = rev * 10 + digit;

            // Remove the last digit from the original number.
            x /= 10;
        }

        // Return the reversed integer.
        return rev;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a Number : ");
        int x = sc.nextInt();

        int ans = reverse(x);

        System.out.println("Reversed Number = " + ans);
    }
}
