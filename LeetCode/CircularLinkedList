 
class ListNode{
    int val;
    ListNode next;
    ListNode(int x){
        val = x;
        next = null;
    }
}

public class Main
{
    
    ListNode head;
    ListNode prev;
    int size = 0;
    
    void insert(int val){
        ListNode temp;
        if(head == null){
            head = new ListNode(val);
            prev = head;
        }else{
            temp = new ListNode(val);
            prev.next = temp;
            prev = temp;
        }
        size++;
    }
    
    void circular(int pos){
		if(pos == -1)
			return;

        int count = 0;
        ListNode temp = head;
        while(temp != null){
            if(count == pos){
                prev.next = temp;
                break;
            }
            temp = temp.next;
            count++;
        }
    }
    
    void print(){
        ListNode temp = head;
        while(temp != null){
            System.out.println("temp.val : " + temp.val);
            temp = temp.next;
        }
        System.out.println();
    }
    
    
	public static void main(String[] args) {
	    Main x = new Main();
	    
	   // Input: head = [3,2,0,-4], pos = 1
	    int arr[] = {3,2,0,-4};
	    int pos = 1;
	    ListNode adding = new ListNode(10);
	    x.insert(10);
	    x.insert(20);
	    x.insert(30);
	    x.insert(40);
	    x.print();
	    x.circular(pos);
	    x.print();
	}
}
