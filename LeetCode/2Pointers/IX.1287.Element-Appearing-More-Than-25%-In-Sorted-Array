// 1287. Element Appearing More Than 25% In Sorted Array
// Given an integer array sorted in non-decreasing order, there is exactly one integer in the array that occurs more than 25% of the time, return that integer.

 

// Example 1:

// Input: arr = [1,2,2,6,6,6,6,7,10]
// Output: 6
// Example 2:

// Input: arr = [1,1]
// Output: 1
 

// Constraints:
// 1 <= arr.length <= 104
// 0 <= arr[i] <= 105

class Main {

    public static int findSpecialInteger(int[] arr) {

        // Explanation:
        // The array is already sorted, so all same elements are together.
        // We use two pointers: slow and fast.
        // slow points to the start of the current element.
        // fast moves forward while the elements are the same.
        // When the element changes, we move slow to the new element.
        // We keep checking the frequency of each element.
        // The element whose frequency is greater than 25% of the array length is our answer.
        
        // Time Complexity:
        // O(n)
        // We traverse the array only once.
        
        // Space Complexity:
        // O(1)
        // We use only a few variables, so no extra space is required.
        
        if(arr.length == 1){
            return arr[0];
        }
        int slow = 0;
        int fast = 1;
        int max = Integer.MIN_VALUE;
        int val = 0;
        while(fast != arr.length){
            if(arr[slow] == arr[fast]){
                fast++;
                if((fast - slow + 1) > max){
                    max = fast - slow + 1;
                    val = arr[slow];
                }
            }else{
                slow = fast;
                fast = slow + 1;
            }
            System.out.println("val " + val + " max " + max);
        }
        return val;
    }

    public static void main(String[] args) {
        // Input: arr = [1,2,2,6,6,6,6,7,10]  Output: 6
        // Input: arr = [1,1]  Output: 1
        // arr =  [1]  Output 0  Expected  1
// arr = [15,15,21,21,32,32,33,33,33,34,35] Output 15 Expected 33

        int arr[] = {15,15,21,21,32,32,33,33,33,34,35};
        int val = findSpecialInteger(arr);
        System.out.println(val);
    }
}
