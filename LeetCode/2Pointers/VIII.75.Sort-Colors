// 75. Sort Colors
// Given an array nums with n objects colored red, white, or blue, sort them in-place so that objects of the same color are adjacent, with the colors in the order red, white, and blue.

// We will use the integers 0, 1, and 2 to represent the color red, white, and blue, respectively.

// You must solve this problem without using the library's sort function.

 

// Example 1:

// Input: nums = [2,0,2,1,1,0]
// Output: [0,0,1,1,2,2]
// Example 2:

// Input: nums = [2,0,1]
// Output: [0,1,2]
 

// Constraints:

// n == nums.length
// 1 <= n <= 300
// nums[i] is either 0, 1, or 2.
 

// Follow up: Could you come up with a one-pass algorithm using only constant extra space?



import java.util.Arrays;

public class Main
{
    
    public static void sortColors(int[] nums) {
        
        int zero = 0, one = 0, two = 0;
        System.out.println(zero + " " + one + " " + two);
        
        for(int i = 0; i < nums.length; i++){
            if(nums[i] == 0) zero++;
            else if (nums[i] == 1) one++;
            else two++;
        }
        
        System.out.println(zero + " " + one + " " + two);
        int zindex = 0, oindex = zero, tindex = (zero+one);
        
        System.out.println(zindex + " " + oindex + " " + tindex);
        // System.out.println(zero + " " + one + " " + two);
        
        int newArr[] = new int[nums.length];

        for(int i = 0; i < nums.length; i++){
            System.out.println("Nums[i " + nums[i]);
            if(nums[i] == 0){
                newArr[zindex] = nums[i];
                System.out.println("zindex " + zindex + " newarr "+ newArr[zindex]);
                zindex++;
                System.out.println("zindex " + zindex);
            }else if(nums[i] == 1){
                newArr[oindex] = nums[i];
                System.out.println("oindex " + oindex + " newarr "+ newArr[oindex]);
                oindex++;
                System.out.println("oindex " + oindex);
            }else{
                newArr[tindex] = nums[i];
                System.out.println("tindex " + tindex + " tindex "+ newArr[tindex]);
                tindex++;
                System.out.println("tindex " + tindex);
            }
        }
        
        System.out.println("New ARR : " + Arrays.toString(newArr));
        // while(left < right){
            
        // }
        
    }

	public static void main(String[] args) {
	    
// Input: nums = [2,0,2,1,1,0]
// Output: [0,0,1,1,2,2]

// Input: nums = [2,0,1]
// Output: [0,1,2]

	   // int target = 12;
	    int arr[] = {2,0,2,1,1,0};
	   // int value = 
	    sortColors(arr);
		System.out.println("Hello World : " + Arrays.toString(arr));
	}
}
