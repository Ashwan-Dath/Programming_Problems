// 75. Sort Colors

// Given an array nums with n objects colored red, white, or blue, sort them in-place so that objects of the same color are adjacent, with the colors in the order red, white, and blue.

// We will use the integers 0, 1, and 2 to represent the color red, white, and blue, respectively.

// You must solve this problem without using the library's sort function.

 

// Example 1:
// Input: nums = [2,0,2,1,1,0]
// Output: [0,0,1,1,2,2]

// Example 2:
// Input: nums = [2,0,1]
// Output: [0,1,2]
 

// Constraints:
// n == nums.length
// 1 <= n <= 300
// nums[i] is either 0, 1, or 2.
 

// Follow up: Could you come up with a one-pass algorithm using only constant extra space?



import java.util.Arrays;

public class Main
{
    
    public static void sortColors(int[] nums) {
        // Approach 1:
        // Count → Calculate positions → Create new array
        // Time: O(n), Space: O(n)
        
        // Approach 2:
        // Three pointers → Partition 0s, 1s, and 2s in-place
        // Time: O(n), Space: O(1)
        // ---------------------------
        
        
        // Approach 2: Dutch National Flag / Three Pointers
        //
        // - Use three pointers: low, mid, and high.
        //
        // - The array is divided into four regions:
        //
        //      [ 0s | 1s | Unknown | 2s ]
        //         ↑     ↑          ↑
        //        low   mid        high
        //
        // - Everything before low is guaranteed to be 0.
        // - Everything between low and mid is guaranteed to be 1.
        // - Everything after high is guaranteed to be 2.
        // - The elements between mid and high are still unknown.
        //
        // - Process nums[mid] until mid > high.
        //
        // - If nums[mid] == 0:
        //      - 0 belongs at the beginning.
        //      - Swap nums[mid] with nums[low].
        //      - Increment both low and mid.
        //
        // - If nums[mid] == 1:
        //      - 1 already belongs in the middle.
        //      - No swap is required.
        //      - Simply increment mid.
        //
        // - If nums[mid] == 2:
        //      - 2 belongs at the end.
        //      - Swap nums[mid] with nums[high].
        //      - Decrement high.
        //      - Do NOT increment mid because the element swapped from
        //        high is still unprocessed and needs to be checked.
        //
        // Time Complexity: O(n)
        // - The mid, low, and high pointers move through the array.
        // - Each element is processed a constant number of times.
        // - Therefore, the overall time complexity is O(n).
        //
        // Space Complexity: O(1)
        // - Only a few variables (low, mid, high, and temp) are used.
        // - No extra array or data structure is created.
        // - Therefore, the extra space complexity is O(1).
        // -----------------------------------------------------

        int low = 0, mid = 0, high = nums.length - 1;
        
        while(mid <= high){
            System.out.println(low + " " + mid + " " + high);
            if(nums[mid] == 0){
                int temp = nums[mid];
                nums[mid] = nums[low];
                nums[low] = temp;
                mid++;
                low++;
            }else if(nums[mid] == 1){
                mid++;
            }else{
                int temp = nums[mid];
                nums[mid] = nums[high];
                nums[high] = temp;
                high--;
            }
        }
        
        
        
        
        
        // Approach 1: Counting + Extra Array

        // - Count how many 0s, 1s, and 2s are present in the array.
        // - Since we know the count of each number, we know where each
        //   group should start in the sorted array.

        // - 0s should be placed first.
        // - 1s should be placed after all 0s.
        // - 2s should be placed after all 0s and 1s.

        // - zindex starts at 0 because 0s should start from index 0.
        // - oindex starts at zero because 1s should start after all 0s.
        // - tindex starts at (zero + one) because 2s should start after
        //   all 0s and 1s.

        // - Traverse the original array again and place each number
        //   into its correct position in the new array.

        // Time Complexity: O(n)
        // - The array is traversed once to count 0s, 1s, and 2s.
        // - The array is traversed again to place the elements.
        // - Two traversals still result in O(n) time.

        // Space Complexity: O(n)
        // - A new array of size n is created.
        // - Therefore, O(n) extra space is used.
        // int zero = 0, one = 0, two = 0;
        // -------------------------------------------
        
        // for(int i = 0; i < nums.length; i++){
        //     if(nums[i] == 0) zero++;
        //     else if (nums[i] == 1) one++;
        //     else two++;
        // }
        
        // int zindex = 0, oindex = zero, tindex = (zero+one);
        
        
        // int newArr[] = new int[nums.length];

        // for(int i = 0; i < nums.length; i++){
        //     System.out.println("Nums[i " + nums[i]);
        //     if(nums[i] == 0){
        //         newArr[zindex] = nums[i];
        //         zindex++;
        //     }else if(nums[i] == 1){
        //         newArr[oindex] = nums[i];
        //         oindex++;
        //     }else{
        //         newArr[tindex] = nums[i];
        //         tindex++;
        //     }
        // }
        
    }

	public static void main(String[] args) {
	    


	    int arr[] = {2,0,2,1,1,0}; 

	    sortColors(arr);
		System.out.println("Hello World : " + Arrays.toString(arr));
	}
}

