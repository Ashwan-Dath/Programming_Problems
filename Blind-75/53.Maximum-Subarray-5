    public static int maxSubArray(int[] nums) {
        
        
        // Approach:
        // - Traverse the array only once.
        // - Maintain:
        //      1. current -> Sum of the current subarray.
        //      2. max -> Maximum sum found so far.
        // - If the current sum becomes negative,
        //   it cannot contribute to a larger future sum.
        // - Reset the current sum to 0.
        // - Continue adding the next elements.
        // - Update the maximum sum whenever a larger sum is found.
        
        // Time Complexity: O(n)
        // - The array is traversed only once.
        // - Each element is processed once.
        // - Therefore, the time complexity is O(n).
        
        // Space Complexity: O(1)
        // - Only two integer variables are used.
        // - No additional data structures are created.
        
        int current = 0;
        int max = Integer.MIN_VALUE;
        
        // Traverse every element.
        for (int i = 0; i < nums.length; i++) {
        
            // If the current sum becomes negative,
            // discard it and start a new subarray.
            if (current < 0)
                current = 0;
        
            // Add the current element.
            current += nums[i];
        
            // Update the maximum sum.
            max = Math.max(max, current);
        }
        
        return max;
        
        
        
        
        
        
        
        
        
        
        
