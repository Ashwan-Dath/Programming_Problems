{
    
    
    public static int maxProduct(int[] nums) {
        
        if(nums.length == 0)
            return 0;
        
        
        // Approach: 
        // - Maintain two values while traversing the array:
        //      1. maxMul -> Maximum product ending at the current index.
        //      2. minMul -> Minimum product ending at the current index.
        // - A negative number can swap the maximum and minimum products.
        // - Therefore, for every element, calculate:
        //      • Current number itself.
        //      • Current number × previous maximum product.
        //      • Current number × previous minimum product.
        // - The largest of these becomes the new maximum product.
        // - The smallest becomes the new minimum product.
        // - Keep updating the overall answer.
        
        // Time Complexity: O(n)
        // - The array is traversed only once.
        // - Each iteration performs constant-time calculations.
        // - Therefore, the time complexity is O(n).
        
        // Space Complexity: O(1)
        // - Only a few integer variables are used.
        // - No extra arrays or data structures are created.
        
        if (nums.length == 0)
            return 0;
        
        int minMul = 1;
        int maxMul = 1;
        int ans = Integer.MIN_VALUE;
        
        // Traverse the array.
        for (int i = 0; i < nums.length; i++) {
        
            int current = nums[i];
        
            // Store the maximum product before updating maxMul.
            int temp = Math.max(
                            Math.max(minMul * current, maxMul * current),
                            current);
        
            // Update the minimum product.
            minMul = Math.min(
                            Math.min(minMul * current, maxMul * current),
                            current);
        
            // Update the maximum product.
            maxMul = temp;
        
            // Update the overall answer.
            ans = Math.max(ans, maxMul);
        }
        
        return ans;


