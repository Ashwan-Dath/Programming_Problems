    public static int[] IntegerArrayInput() {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the Size of the Array : ");
        int size = sc.nextInt();

        int[] arr = new int[size];
        for (int i = 0; i < size; i++) {
