// 153. Find Minimum in Rotated Sorted Array
// Suppose an array of length n sorted in ascending order is rotated 
// between 1 and n times. For example, the array nums = [0,1,2,4,5,6,7] might become:

// [4,5,6,7,0,1,2] if it was rotated 4 times.
// [0,1,2,4,5,6,7] if it was rotated 7 times.
// Notice that rotating an array [a[0], a[1], a[2], ..., a[n-1]] 1 time results 
// in the array [a[n-1], a[0], a[1], a[2], ..., a[n-2]].

// Given the sorted rotated array nums of unique elements, return the minimum element of this array.

// You must write an algorithm that runs in O(log n) time.

 

// Example 1:

// Input: nums = [3,4,5,1,2]
// Output: 1
// Explanation: The original array was [1,2,3,4,5] rotated 3 times.
// Example 2:

// Input: nums = [4,5,6,7,0,1,2]
// Output: 0
// Explanation: The original array was [0,1,2,4,5,6,7] and it was rotated 4 times.
// Example 3:

// Input: nums = [11,13,15,17]
// Output: 11
// Explanation: The original array was [11,13,15,17] and it was rotated 4 times. 
 

// Constraints:

// n == nums.length
// 1 <= n <= 5000
// -5000 <= nums[i] <= 5000
// All the integers of nums are unique.
// nums is sorted and rotated between 1 and n times.


import java.util.*;

public class Main
{
    public static int findMin(int[] nums) {
        // Sort Array Approach O(log n).
        // Arrays.sort(nums);
        // return nums[0];
       
        
        // Approach:
        // - Maintain a variable 'ans' to store the smallest value found so far.
        // - At each step:
        //      1. If the current search range is already sorted,
        //         update 'ans' with the leftmost element.
        //      2. Find the middle element and update 'ans'.
        //      3. Determine which half is sorted.
        //      4. Ignore the sorted half and search the unsorted half,
        //         because the minimum must be there.
        // - Continue until the search space is exhausted.
        
        // Time Complexity: O(log n)
        // - Binary Search halves the search space in every iteration.
        // - Therefore, the time complexity is O(log n).
        
        // Space Complexity: O(1)
        // - Only a few integer variables are used.
        // - No extra data structures are required.
        
        int left = 0;
        int right = nums.length - 1;
        int ans = nums[0];
        
        // If there is only one element,
        // it is the minimum.
        if (nums.length == 1)
            return nums[0];
        
        while (left <= right) {
        
            // If the current portion is sorted,
            // the leftmost element is the smallest in this range.
            if (nums[left] <= nums[right]) {
                ans = Math.min(ans, nums[left]);
                break;
            }
        
            int mid = (left + right) / 2;
        
            // Update the minimum with the middle element.
            ans = Math.min(ans, nums[mid]);
        
            // Check whether the left half is sorted.
            if (nums[left] <= nums[mid]) {
        
                // The left half is sorted, so the minimum
                // must be in the right half.
                left = mid + 1;
        
            } else {
        
                // The right half is sorted,
                // so the minimum lies in the left half.
                right = mid - 1;
            }
        }
        
        return ans;
    }

