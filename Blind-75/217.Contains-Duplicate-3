    public static boolean ContainsDuplicate(int []nums){
        
        // Approach: My optimal approach after knowing about the HashSet.
        // - Use a HashSet to keep track of the elements we have already seen.
        // - Traverse the array one element at a time.
        // - For each element:
        //      1. Check whether it already exists in the HashSet.
        //      2. If it exists, a duplicate has been found, so return true.
        //      3. Otherwise, add the element to the HashSet.
        // - If the loop finishes without finding any duplicates,
        //   return false because all elements are distinct.
        
        // Time Complexity: O(n)
        // - We traverse the array only once.
        // - HashSet operations (contains() and add()) take O(1) on average.
        // - Therefore, the overall time complexity is O(n).
        
        // Space Complexity: O(n)
        // - In the worst case, all elements are unique.
        // - The HashSet stores every element.
        // - Therefore, the extra space required is O(n).
        
        Set<Integer> check = new HashSet<>();
        
        // Traverse each element in the array.
        for (int i = 0; i < nums.length; i++) {
        
            // If the element already exists in the HashSet,
            // a duplicate has been found.
            if (check.contains(nums[i])) {
                return true;
            }
        
            // Otherwise, store the element in the HashSet.
            check.add(nums[i]);
        }
        
        // No duplicate element was found.
        return false;
        
        
        
        
        
        
        
        
